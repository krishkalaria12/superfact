# Neon Postgres. Required from phase 00.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Model provider for extraction, adjudication, and embeddings. OpenAI is the default.
# Set AI_PROVIDER=gemini and add a Google AI Studio key to use Gemini instead.
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# UploadThing, for PDF bytes and page rasters. Required from phase 02 — uploads are the only
# way a document enters the system.
UPLOADTHING_TOKEN=

# Inngest. Leave empty for local development — `pnpm dev` runs the Inngest dev server,
# which needs no keys. Both are required once deployed.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
