# Neon Postgres. Required from phase 00.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Model provider for extraction and adjudication. Required from phase 04.
OPENAI_API_KEY=

# Vercel Blob, for PDF bytes and page rasters. Required from phase 02.
BLOB_READ_WRITE_TOKEN=

# Inngest. Leave empty for local development — `pnpm dev` runs the Inngest dev server,
# which needs no keys. Both are required once deployed.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
